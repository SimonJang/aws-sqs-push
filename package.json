{
	"name": "aws-sqs-push",
	"version": "3.0.3",
	"description": "Push messages to an AWS (FIFO) SQS queue",
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"license": "MIT",
	"repository": "https://github.com/SimonJang/aws-sqs-push",
	"author": {
		"name": "Simon Jang",
		"email": "simon.jang.contact@gmail.com",
		"url": "https://github.com/SimonJang"
	},
	"engines": {
		"node": ">=8"
	},
	"scripts": {
		"clean": "node -e \"require('fs').rmSync('lib', {recursive: true, force: true})\"",
		"build": "npm run clean && tsc --project tsconfig.json",
		"test": "npm run build && npm run test:runtime && npm run test:types",
		"test:runtime": "node --test test/runtime.test.js",
		"test:types": "tsc --project tsconfig.test.json && node node_modules/typescript-3-7/lib/tsc.js --project tsconfig.legacy.json",
		"test:install": "node test/git-install-smoke.js",
		"prepare": "npm run build",
		"prepack": "npm test",
		"deploy": "npm run prepack && npx np"
	},
	"files": [
		"lib"
	],
	"keywords": [
		"AWS",
		"SQS",
		"queue",
		"message",
		"push",
		"FIFO"
	],
	"dependencies": {
		"obj-clean": "^3.0.1"
	},
	"peerDependencies": {
		"aws-sdk": "^2.580.0"
	},
	"devDependencies": {
		"@types/node": "22.20.1",
		"aws-sdk": "2.1693.0",
		"types-node-8": "npm:@types/node@8.10.66",
		"typescript": "7.0.2",
		"typescript-3-7": "npm:typescript@3.7.5"
	},
	"packageManager": "npm@12.0.1"
}
