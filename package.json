{
	"name": "aws-sqs-push",
	"version": "3.0.3",
	"description": "Push messages to an AWS (FIFO) SQS queue",
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"license": "MIT",
	"repository": "https://github.com/SimonJang/aws-sqs-push",
	"author": {
		"name": "Simon Jang",
		"email": "simon.jang.contact@gmail.com",
		"url": "https://github.com/SimonJang"
	},
	"engines": {
		"node": ">=8"
	},
	"scripts": {
		"clean": "node scripts/clean.js",
		"build": "npm run clean && tsc --project tsconfig.json",
		"test": "npm run build && npm run test:runtime && npm run test:types",
		"test:runtime": "node --test test/runtime.test.js",
		"test:types": "tsc --project tsconfig.legacy.json && npm --prefix test/modern ci --ignore-scripts && node test/modern/node_modules/typescript/lib/tsc.js --project tsconfig.test.json",
		"test:install": "node test/git-install-smoke.js",
		"prepare": "npm run build",
		"prepublishOnly": "npm test",
		"deploy": "npm run prepublishOnly && npx np"
	},
	"files": [
		"lib"
	],
	"keywords": [
		"AWS",
		"SQS",
		"queue",
		"message",
		"push",
		"FIFO"
	],
	"dependencies": {
		"obj-clean": "^3.0.1"
	},
	"peerDependencies": {
		"aws-sdk": "^2.580.0"
	},
	"devDependencies": {
		"@types/node": "8.10.66",
		"aws-sdk": "2.1693.0",
		"sax": "1.2.4",
		"typescript": "3.7.5"
	},
	"packageManager": "npm@12.0.1"
}
